# ────────────────────────────────────────────────────────────────
#  SWINE SYNC — ตัวแปรสภาพแวดล้อม
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  →  cp .env.example .env
#  **ห้าม commit .env** (อยู่ใน .gitignore แล้ว)
# ────────────────────────────────────────────────────────────────

# ---------- ดาต้าเบส ----------
POSTGRES_USER=swine
POSTGRES_PASSWORD=เปลี่ยนรหัสนี้ก่อนใช้จริง
POSTGRES_DB=swinesync
# พอร์ตที่เปิดออกมาให้เครื่องเราต่อเข้าไปดูได้ (ในวง compose ใช้ db:5432 เสมอ)
DB_PORT=5432

# ---------- บัญชีผู้ดูแลระบบคนแรก ----------
# หลังบ้านสร้างบัญชีนี้ให้เองตอนขึ้นระบบครั้งแรก (server/src/db/seed)
# **ไม่มีค่าสามตัวนี้ = ขึ้นระบบใหม่แล้วไม่มีใครล็อกอินเข้าไปได้เลย**
# ตั้งรหัสใหม่ทุกครั้งที่ย้ายเครื่อง ห้ามยกรหัสเดิมมาใช้ซ้ำ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=ผู้ดูแลระบบ

# ---------- API ----------
# หมายเหตุ: ห้ามใส่ NODE_ENV ที่นี่ — vite อ่านไฟล์ .env นี้ด้วยแล้วจะเตือน
# (NODE_ENV ของหลังบ้านกำหนดไว้ใน docker-compose.yml แล้ว)
API_PORT=3000

# ---------- นโยบายข้อมูลตามเวลา (ข้อ 14 ของ docs/BACKEND.md) ----------
# ตั้งเป็นค่าตั้ง ไม่ฝังในโค้ด เพราะยังไม่มีข้อกำหนดว่าต้องเก็บกี่ปี
COMPRESS_AFTER_DAYS=7
RAW_RETENTION_DAYS=90

# ---------- สะพานอ่านค่าจาก InfluxDB ที่ Node-RED เขียนไว้ ----------
# host.docker.internal = เครื่อง Mac ที่รัน Docker (Influx ไม่ได้อยู่ใน compose นี้)
INFLUX_URL=http://host.docker.internal:8086
INFLUX_ORG=swinefarm
INFLUX_BUCKET=climatesensor
INFLUX_MEASUREMENT=kampangphet
# token สิทธิ์ "อ่านอย่างเดียว" ของ bucket ด้านบน — สร้างที่ http://localhost:8086
INFLUX_TOKEN=
# ดึงค่าใหม่ทุกกี่วินาที
BRIDGE_INTERVAL_SEC=30
# ดึงย้อนหลังกี่วันตอนเริ่มทำงานครั้งแรก (ข้อมูลจริงมีตั้งแต่ 8 ก.ค. 2026)
BRIDGE_BACKFILL_DAYS=60
# บทบาทของสะพาน: full (ตั้งต้น · เครื่องเดียวจบ) · sync (อ่าน Influx เท่านั้น)
#              · alerts (คิดแจ้งเตือน + ส่งไลน์ + เฝ้าระวัง)
# ห้ามรัน alerts/full สองที่พร้อมกันบนฐานเดียวกัน — จะเปิดใบซ้ำและส่งไลน์สองชุด
BRIDGE_ROLE=full

# ---------- AI ของฟาร์ม (ทีมอื่นในโปรเจกต์ทำไว้) ----------
# ⚠️ กุญแจนี้ใช้ได้เฉพาะฝั่งเซิร์ฟเวอร์ **ห้ามเอาไปไว้ในโค้ดหน้าเว็บ**
#    (ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูกฝังลงไฟล์ที่ผู้ใช้เปิดดูได้ — อย่าตั้งชื่อแบบนั้นเด็ดขาด)
CPF_AI_URL=https://ota.plotnexuslab.com/ai/api
CPF_AI_API_KEY=
# ชื่อผู้ใช้ที่ "ลงทะเบียนไว้กับฝั่ง AI แล้ว" — เขารับเฉพาะชื่อที่รู้จัก ส่งชื่อมั่ว ๆ ไปจะได้ 401
CPF_AI_USER_ID=
# แปลงชื่อผู้ใช้ของแดชบอร์ดเรา → ชื่อฝั่งเขา  ไม่มีในตารางนี้จะใช้ CPF_AI_USER_ID แทน
CPF_AI_USER_MAP={"admin":"test1"}
# ระดับคำตอบที่กุญแจนี้ขอได้ (ดูจาก max_level ที่ /whoami ตอบมา)
CPF_AI_LEVEL=1

# ────────────────────────────────────────────────────────────────
#  PlotNexus Lab — แหล่งข้อมูลเซนเซอร์เดิม · ★ ปิดไว้ตั้งแต่ 19 ต.ค. 2569 (T1.342)
# ────────────────────────────────────────────────────────────────
#  กุญแจถูกถอนสิทธิ์ 11 ก.ย. 2569 แอปเคยยิงไปโดน 403 ทุกครั้งที่ยังไม่ได้เข้าสู่ระบบ
#  ข้อมูลจริงอยู่ในระบบกลาง (กล่อง box-mew) แล้ว — เข้าสู่ระบบก็เห็น ไม่ต้องใช้กุญแจนี้
#  เปิดคืนเมื่อได้สิทธิ์กลับมา: ตั้งบรรทัดล่างเป็น 1 (ไม่ตั้ง = ปิด)
VITE_PLOTNEXUS_ENABLED=0
#  **ตัวนี้ขึ้นต้นด้วย VITE_ โดยตั้งใจ** ต่างจากกุญแจ AI ที่ห้ามเด็ดขาด
#  เพราะเป็นกุญแจ "อ่านอย่างเดียว" (labro_ = lab read-only) และเจ้าของบริการ
#  บอกเองว่าหน้าที่วางไว้ใครมีลิงก์ก็เปิดได้ จะเห็นกุญแจในโค้ดอยู่แล้ว
#  ถ้าวันหนึ่งได้กุญแจที่ "เขียนข้อมูลได้" มา ห้ามเอามาใส่ตรงนี้ ต้องผ่านหลังบ้านเท่านั้น
VITE_PLOTNEXUS_KEY=labro_ใส่กุญแจที่ได้มาตรงนี้

# ─────────────────────────────────────────────────────────────────────────────
# ระบบวอยซ์ Farmy (ทีมอื่นในโปรเจกต์ — fern.plotnexuslab.com)
#  แผงวอยซ์ในแดชบอร์ดถาม AI ของเขาผ่านหลังบ้านของเรา ไม่ได้ยิงตรงจากเบราว์เซอร์
#  (ยิงตรงติด CORS และ token ของเขาเป็นสิทธิ์ผู้ดูแลทั้งระบบ ห้ามไว้ในหน้าเว็บ)
#  ⚠️ บัญชีนี้ถูกใช้ร่วมกันทุกคนที่ถามผ่านแดชบอร์ด — ฝั่ง Farmy จะแยกไม่ออกว่าใครถาม
#     ใช้สำหรับสาธิตก่อน ถ้าจะใช้จริงต้องรอ SSO (T1.244) หรือขอ token รายคน
#  ไม่ตั้ง = แผงวอยซ์ตอบด้วย AI ของ CPF และข้อมูลตัวอย่างเหมือนเดิม ไม่พัง
# FARMY_URL=https://fern.plotnexuslab.com
# FARMY_USERNAME=
# FARMY_PASSWORD=

# พอร์ตของหน้าเว็บ (คอนเทนเนอร์ web)
#  WEB_PORT   = http   ค่าตั้งต้น 8080
#  HTTPS_PORT = https  ค่าตั้งต้น 8443 — **ต้องมีใบรับรองก่อน** สร้างด้วย `sh ops/make-cert.sh`
#  ⚠️ เบราว์เซอร์ให้ใช้ไมโครโฟนกับกล้องเฉพาะหน้าที่เป็น https หรือ localhost เท่านั้น
#     เปิดจากมือถือด้วย http://<ไอพี>:8080 เมื่อไหร่ วอยซ์กับกล้องจะใช้ไม่ได้ทันที
# WEB_PORT=8080
# HTTPS_PORT=8443

# ที่อยู่ของหลังบ้าน (ฝั่งหน้าเว็บ)
# ─────────────────────────────────────────────────────────────────────────────
#  ปกติ **ไม่ต้องตั้ง** — หน้าเว็บเรียก /api ของโดเมนเดียวกัน แล้ว nginx ส่งต่อให้
#  ตั้งเมื่อเอาหน้าเว็บไปวางคนละโดเมนกับ API เท่านั้น เช่น
#    VITE_API_BASE=https://api.ฟาร์มของเรา.com/api
#  และค่า `none` แปลว่า "สำเนานี้ไม่มีหลังบ้าน" — ทุกคำขอถูกปฏิเสธก่อนส่งออก
#  (`npm run build:host` ใช้ค่านี้เป็นค่าตั้งต้น เพื่อไม่ให้สำเนาที่วางบนโฮสต์ของคนอื่น
#   ส่งชื่อผู้ใช้/รหัสผ่านไปที่ /api ของโดเมนนั้น ซึ่งเป็นเซิร์ฟเวอร์ของคนอื่น)
# VITE_API_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# โดเมนที่ยอมให้เรียก API ข้ามโดเมน (ฝั่งเซิร์ฟเวอร์)
# ─────────────────────────────────────────────────────────────────────────────
#  เว้นว่าง = ไม่เปิดให้ใครเลย (ถูกแล้วสำหรับการติดตั้งปกติ)
#  ตั้งคู่กับ VITE_API_BASE เมื่อหน้าเว็บอยู่คนละโดเมน คั่นหลายโดเมนด้วยจุลภาค
#  **ห้ามใส่ `*`** — API ตัวนี้รับ Authorization เป็นกุญแจ session
#  เปิดให้ทุกโดเมนเท่ากับให้เว็บไหนก็ได้ยิงคำขอแทนผู้ใช้ที่ล็อกอินอยู่ (โค้ดจะไม่รับค่านี้)
# CORS_ORIGINS=https://lab.plotnexuslab.com

# ---------- ส่งสรุป/แจ้งเตือนเข้า LINE OA (T1.275) ----------
# กุญแจออกจาก LINE Developers Console แท็บ Messaging API → Channel access token (long-lived)
# **ไม่ใช่** Channel secret ที่เห็นในหน้า LINE Official Account Manager
# ห้ามตั้งชื่อขึ้นต้น VITE_ เด็ดขาด — vite จะฝังลงไฟล์ที่เบราว์เซอร์โหลดได้
LINE_CHANNEL_ACCESS_TOKEN=
# broadcast = ทุกคนที่เป็นเพื่อนกับ OA (ไม่ต้องมี webhook) · push:<userId|groupId> = เฉพาะปลายทางเดียว
# Channel secret (แท็บ Basic settings) — ใช้ตรวจลายเซ็นของข้อความที่คนพิมพ์เข้ามา
LINE_CHANNEL_SECRET=
LINE_TARGET=broadcast
# 1 = โหมดซ้อม ประกอบข้อความลง log แต่ไม่ส่งออกจริง · ตั้ง 0 เมื่อพร้อมส่งจริงเท่านั้น
LINE_DRY_RUN=1
# 0 = ปิดตัวส่งทั้งหมด
LINE_NOTIFY=1
# เวลาส่งสรุปประจำวัน (เวลาไทย) — สรุปของ "เมื่อวาน" เต็มวัน
LINE_DAILY_AT=07:30
# เพดานจำนวนครั้งที่ส่งต่อวัน — ตาข่ายกันบัคยิงรัวจนโควตาเดือนหมด
LINE_MAX_PER_DAY=20
# ระดับที่ส่งเข้าไลน์ — เพิ่ม warning ต่อท้ายได้ถ้าอยากได้ทุกเหตุ (จะถี่ขึ้นมาก)
LINE_ALERT_LEVELS=critical,serious,warning
# เรื่องเดิม (โรงเรือน+รหัสเหตุ) เตือนซ้ำได้ทุกกี่ชั่วโมง — กันเหตุที่เกิดซ้ำ ๆ ยิงรัว
LINE_ALERT_COOLDOWN_HOURS=12
# เหตุที่เปิดค้างเกินกี่นาทีแล้วไม่ต้องส่งย้อนหลัง
LINE_ALERT_MAX_AGE_MIN=60
# ลิงก์ปุ่ม "เปิดแดชบอร์ด" ท้ายการ์ด (เว้นว่าง = ไม่มีปุ่ม)
DASHBOARD_URL=

# ---------- ฐานข้อมูลเครื่องอื่น (ใช้เมื่อแยกเครื่องกับที่เก็บข้อมูล) ----------
# ว่างไว้ = ใช้ฐานในวง compose ของตัวเอง
# ของจริงตอนนี้: สะพานบนเครื่องผู้พัฒนาเขียนลงฐานที่รันบนกล่อง box-mew ผ่านเทลเน็ต
# ★ มีรหัสฐานข้อมูลอยู่ในสายนี้ ถือเป็นความลับเท่ากับ POSTGRES_PASSWORD
# รูป: postgres://ผู้ใช้:รหัส@ที่อยู่:5432/ชื่อฐาน
REMOTE_DATABASE_URL=

# ---------- เฝ้าระวังว่าเครื่องหลักยังตอบอยู่ไหม ----------
# ใช้ตอนมีสองเครื่อง (เครื่องผู้พัฒนา + กล่อง) ให้ตัวสำรองคอยถามเครื่องหลักแล้วแจ้งเตือนถ้าเงียบ
PRIMARY_NAME=box-mew
PRIMARY_HEALTH_URL=
# ถามทุกกี่นาที
PRIMARY_CHECK_MIN=10
# แจ้งเข้าไลน์เมื่อเครื่องหลักเงียบ (true/false)
PRIMARY_WATCH_NOTIFY=false

# ---------- ตัวเฝ้าข้อมูล: ส่งคำเตือนเข้าไลน์หรือไม่ ----------
# ★ docker-compose.yml ตั้งต้นให้เป็น **0** (ตรวจอยู่แต่ไม่ส่ง) ต้องตั้งที่นี่เป็น 1 เองถึงจะส่ง
#   ไม่ตั้ง = ตัวเฝ้าเห็นปัญหาแต่ไม่มีใครรู้ ซึ่งเป็นสิ่งที่ตัวเฝ้ามีไว้กันแต่แรก
# ตรวจทุก 5 นาที (FLOW_CHECK_MIN) แต่เตือนซ้ำวันละครั้ง (FLOW_REMIND_MIN=1440)
# จึงกินโควตาไลน์ไม่เกินราว 30 ข้อความ/เดือน จากโควตา 300
FLOW_WATCH_NOTIFY=1

# ---------- ค่าที่มีเฉพาะบน box-mew ----------
# กล่องรันโดยไม่มี Docker จึงต้องตั้งสามตัวนี้เองในไฟล์ .env ของกล่อง
# (บนเครื่องผู้พัฒนาไม่ต้องใส่ — docker-compose.yml กำหนดให้แล้ว และ vite จะเตือนถ้ามี NODE_ENV)
#NODE_ENV=production
#TZ=Asia/Bangkok
#LOG_LEVEL=info
# โดเมนที่อนุญาตให้เรียก API ข้ามที่มาได้ คั่นด้วยจุลภาค
#CORS_ORIGINS=
# ฐานข้อมูลที่กล่องใช้ (กล่องใช้ชื่อนี้ ไม่ใช่ REMOTE_DATABASE_URL)
#DATABASE_URL=
# ไม่เอาใบแจ้งเตือนที่เก่ากว่านี้ไปส่งไลน์ (นาที)
#LINE_ALERT_MAX_AGE_MIN=120

# ---------- ส่งคำสั่งไปตู้ควบคุม/PLC (T1.284 · T1.310) ----------
# ไม่ตั้ง = hold คือตรวจครบทุกด่านแล้วเก็บคำสั่งเข้าคิว **ไม่ส่งไปไหน** (ค่าที่ใช้อยู่วันนี้)
#
# เปิดทางส่งจริงได้เมื่อ Node-RED พร้อมมาดึงคำสั่งไป publish ให้ PLC เอง:
#   1. ตั้งสองบรรทัดล่างนี้  2. รีสตาร์ต api  3. ตั้ง flow ใน Node-RED ให้ถาม
#      GET  /api/control/outbox            (ส่ง header x-outbox-token)
#      POST /api/control/outbox/<id>/ack   {"ok":true|false,"detail":"..."}
#
# ★ topic กับรูป payload ที่ PLC รับ **เขียนใน Node-RED ไม่ใช่ในโค้ดนี้**
#   เลือกทางนี้ตั้งแต่ต้นเพราะ Node-RED ถือ credential ของฟาร์มอยู่แล้ว
#   และคำสั่งไม่ต้องวิ่งผ่าน broker สาธารณะ (ใครก็ publish ปลอมเข้า topic เดียวกันได้)
#CONTROL_TRANSPORT=outbox
# กุญแจเครื่องต่อเครื่องของกล่องขาออก — ไม่ตั้ง = เส้นทางนั้นปิดสนิท (503)
# สร้างด้วย: openssl rand -hex 32
#CONTROL_OUTBOX_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# ความลับสำหรับเข้ารหัสกุญแจของกล่องรับข้อมูล (T1.347)
# ─────────────────────────────────────────────────────────────────────────────
#  กุญแจที่ออกให้แต่ละกล่องถูกเก็บลงฐานแบบ **เข้ารหัสแล้ว** (aes-256-gcm)
#  ค่านี้คือกุญแจถอดรหัสของมัน — ไม่ตั้ง = เปิดดูกุญแจย้อนหลังไม่ได้ ต้องออกใบใหม่
#  เปลี่ยนค่านี้ = กุญแจเก่าทุกใบถอดไม่ออกอีกเลย (ของเดิมไม่ได้เสีย แต่ดูไม่ได้)
#  สร้างด้วย: openssl rand -hex 32
#HUB_KEY_SECRET=
