# ═══════════════════════════════════════════════════════════════════════
#  ค่าตั้งของคลังข้อมูลสำหรับเทรนโมเดล
#
#  วิธีใช้:  cp .env.example .env  แล้วเติมค่าที่ทำเครื่องหมาย ← ไว้
#  ไฟล์ .env จริงห้าม commit (ถูกกันไว้ใน .gitignore ของโปรเจกต์แล้ว)
# ═══════════════════════════════════════════════════════════════════════

# ─── ฐานข้อมูลของคลังนี้ ───
# รหัสผ่านนี้ใช้แค่ในวง Docker ของเครื่องนี้ ฐานไม่ได้เปิดออกนอกเครื่อง
WX_DB_USER=wx
WX_DB_PASSWORD=เปลี่ยนเป็นรหัสอะไรก็ได้ที่ยาวพอ
WX_DB_NAME=wx
# 5433 เพราะ 5432 เป็นของฐานแดชบอร์ดอยู่แล้ว
WX_DB_PORT=5433

# ─── กุญแจของ PlotNexus (คลาวด์ของพี่เลี้ยง) — ★ ปิดไว้ตั้งแต่ 19 ต.ค. 2569 ───
# กุญแจถูกถอนสิทธิ์ 11 ก.ย. 2569 · ค่าเซนเซอร์อ่านจากกล่อง box-mew แทน (ดู SWINE_DB_URL)
# เปิดคืนเมื่อได้สิทธิ์กลับมา: เปลี่ยนบรรทัดล่างเป็น 1
PLOTNEXUS_ENABLED=0
# ก๊อบค่าเดียวกับ VITE_PLOTNEXUS_KEY ใน .env ของโปรเจกต์หลักได้เลย
# เป็นกุญแจอ่านอย่างเดียว (ขึ้นต้น labro_) แก้ข้อมูลของเขาไม่ได้
PLOTNEXUS_KEY=
PLOTNEXUS_SOURCE=pig
# ถามค่าล่าสุดทุกกี่วินาที — ถามถี่กว่าที่เซนเซอร์ส่งไม่ทำให้ได้แถวซ้ำ
PLOTNEXUS_EVERY_SEC=60

# ─── พิกัดฟาร์ม (ใช้ถาม Open-Meteo) ───
# ค่าตั้งต้นคือฟาร์มกำแพงเพชร เปลี่ยนเมื่อย้ายไปฟาร์มอื่น
FARM_LAT=16.4828
FARM_LON=99.5222
# ค่าเป็นรายชั่วโมง ถามถี่กว่านี้ได้ค่าเดิม
OPEN_METEO_EVERY_SEC=900

# ─── ฐานของแดชบอร์ด = แหล่งค่าเซนเซอร์หลัก ───  ←
# ★ ต้องเป็นฐานบน **กล่อง box-mew** — ก๊อบค่า REMOTE_DATABASE_URL จาก .env ของโปรเจกต์หลักมาเลย
#   ไม่ใช่ host.docker.internal ซึ่งเป็นฐานในเครื่องนี้ และหยุดรับค่าเซนเซอร์ตั้งแต่ 29 ก.ย. 2569
#   ชี้ผิดที่ = เก็บได้แต่ของเก่า โดยไม่มีอะไรฟ้องว่าผิด
# ปล่อยว่างไว้ได้ แต่จะไม่มีค่าในเล้าเลย เหลือแต่อากาศภายนอกจาก Open-Meteo
SWINE_DB_URL=postgres://swine:รหัสผ่านของฐานบนกล่อง@100.102.230.64:5432/swinesync
# ถามหาแถวใหม่ทุกกี่วินาที (สะพานเขียนลงฐานนั้นทุก 30 วินาที)
SWINE_EVERY_SEC=60

# ─── JupyterLab ───
WX_LAB_PORT=8899
